extends ../layout

block content
    .container-fluid.p-0
        .d-flex.justify-content-between.align-items-center.mb-4
            h1.h3.mb-0 Grade List
            a.btn.btn-primary(href="/add-grade") 
                i.bi.bi-plus-circle
                |  Add New Grade

        .row
            .col-12
                .card
                    .card-body                       
                        if grades && grades.length > 0
                            .table-responsive
                                table.table.table-striped
                                    thead
                                        tr
                                            th ID
                                            th Student ID
                                            th Subject ID
                                            th Term ID
                                            th Marks
                                            th Grade
                                            th Actions
                                    tbody
                                        each grade in grades
                                            tr
                                                td #{grade.ID}
                                                td #{grade.Student_ID}
                                                td #{grade.Subject_ID}
                                                td #{grade.Term_ID}
                                                td #{grade.Marks}
                                                td #{grade.Grade}
                                                td.table-action
                                                    a(href=`/edit-grade/${grade.ID}`)
                                                        i.align-middle(data-feather="edit-2")
                                                    // Delete modal trigger
                                                    a(href="#", data-bs-toggle="modal", data-bs-target=`#deleteModal-${grade.ID}`)
                                                        i.align-middle(data-feather="trash")

                                                    // Delete Modal
                                                    .modal.fade(id=`deleteModal-${grade.ID}` tabindex="-1" aria-labelledby="deleteModalLabel-${grade.ID}" aria-hidden="true")
                                                        .modal-dialog
                                                            .modal-content
                                                                .modal-header
                                                                    h5.modal-title(id=`deleteModalLabel-${grade.ID}`) Delete Grade?
                                                                    button.btn-close(type="button" data-bs-dismiss="modal" aria-label="Close")
                                                                .modal-body
                                                                    p This will delete the grade permanently.
                                                                .modal-footer
                                                                    button.btn.btn-secondary(type="button" data-bs-dismiss="modal") Cancel
                                                                    form(action=`/delete-grade/${grade.ID}` method="POST")
                                                                        button.btn.btn-danger(type="submit") Delete
                        else
                            .text-center.py-4
                                p.text-muted No grades found.
                                a.btn.btn-primary(href="/add-grade") 
                                    i.bi.bi-plus-circle
                                    |  Add First Grade
