extends ../layout

block content
    .container-fluid.p-0
        h1.h3.mb-3 Edit Grade
        .row
            .col-12.col-xl-12
                .card
                    .card-body
                        form(action=`/edit-grade/${grade.ID}` method="POST")
                            .mb-3
                                label.form-label(for="Student_ID") Student
                                select.form-select(name="Student_ID" required)
                                    option(value="") -- Select Student --
                                    each student in students
                                        option(
                                            value=student.Student_ID,
                                            selected=(student.Student_ID === grade.Student_ID)
                                        ) #{student.F_name} #{student.L_name}

                            .mb-3
                                label.form-label(for="Subject_ID") Subject
                                select.form-select(name="Subject_ID" required)
                                    option(value="") -- Select Subject --
                                    each subject in subjects
                                        option(
                                            value=subject.Subject_ID,
                                            selected=(subject.Subject_ID === grade.Subject_ID)
                                        ) #{subject.Name}

                            .mb-3
                                label.form-label(for="Term_ID") Term
                                select.form-select(name="Term_ID" required)
                                    option(value="") -- Select Term --
                                    each term in terms
                                        option(
                                            value=term.Term_ID,
                                            selected=(term.Term_ID === grade.Term_ID)
                                        ) #{term.Name}

                            .mb-3
                                label.form-label(for="Marks") Marks
                                input.form-control(type="number" name="Marks" value=grade.Marks required)

                            .mb-3
                                label.form-label(for="Grade") Grade
                                input.form-control(type="text" name="Grade" value=grade.Grade required)

                            button.btn.btn-primary(type="submit") Update Grade
